{
  "name": "dev-shortcuts",
  "displayName": "dev-shortcuts",
  "description": "Dev Shortcuts example for VS Code",
  "version": "1.0.0",
  "publisher": "rafael-vieira",
  "repository": "https://github.com/RafaelHDSV/Dev-Shortcuts",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.devShortcuts",
        "title": "Dev Shortcuts: Inserir snippet"
      }
    ],
    "configuration": {
      "title": "Dev Shortcuts",
      "properties": {
        "devShortcuts.customSnippets": {
          "type": "array",
          "default": [],
          "description": "Snippets customizados do Dev Shortcuts",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              },
              "body": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "body"
            ]
          }
        }
      }
    },
    "snippets": [
      {
        "language": "typescriptreact",
        "path": "./src/snippets/react.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./src/snippets/react.code-snippets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^22",
    "@types/vscode": "^1.100.0",
    "eslint": "^9.13.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
